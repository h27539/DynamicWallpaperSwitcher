      }
    },
    "只删除本 App 管理的资源；不会触及 Apple、Golden Gate 或其他自定义壁纸。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only resources managed by this App will be removed. Apple, Golden Gate, and other custom wallpapers will not be touched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删除本 App 管理的资源；不会触及 Apple、Golden Gate 或其他自定义壁纸。"
          }
        }
      }
    },
    "迁移这张旧版壁纸？": {
