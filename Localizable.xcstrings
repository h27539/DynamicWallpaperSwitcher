{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "自定义动态壁纸": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom Dynamic Wallpapers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义动态壁纸"
          }
        }
      }
    },
    "将普通视频转换为 macOS 原生 Aerial 动态壁纸。锁屏时播放，解锁后自然停留在桌面背景。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert ordinary videos into macOS Aerial-compatible dynamic wallpapers. They play on the Lock Screen and become a still desktop background after unlocking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将普通视频转换为 macOS 原生 Aerial 动态壁纸。锁屏时播放，解锁后自然停留在桌面背景。"
          }
        }
      }
    },
    "+ 添加视频": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "+ Add Video"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "+ 添加视频"
          }
        }
      }
    },
    "环境": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
